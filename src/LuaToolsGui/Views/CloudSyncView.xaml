<UserControl
    x:Class="LuaToolsGui.Views.CloudSyncView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:res="clr-namespace:LuaToolsGui.Resources"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:LuaToolsGui.ViewModels"
    d:DataContext="{d:DesignInstance Type=vm:CloudSyncViewModel}"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="#08FFFFFF" />
            <Setter Property="BorderBrush" Value="#12FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,18,0,8" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9ca3af" />
        </Style>

        <Style x:Key="TabRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9ca3af" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#10FFFFFF" />
                                <Setter Property="Foreground" Value="#e5e7eb" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" Margin="8,16,16,24">

                <!-- Header -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="22"
                            FontWeight="Bold"
                            Text="Cloud Sync" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="13"
                            Foreground="#9ca3af"
                            Text="Steam Cloud save redirection, backup, and sync management"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Active Provider Status Badge -->
                    <Border
                        Grid.Column="1"
                        Padding="10,4"
                        VerticalAlignment="Center"
                        Background="#10FFFFFF"
                        BorderBrush="#15FFFFFF"
                        BorderThickness="1"
                        CornerRadius="6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon
                                VerticalAlignment="Center"
                                FontSize="13"
                                Foreground="{Binding AuthStatusBrush}"
                                Symbol="Cloud24" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#e5e7eb"
                                Text="{Binding SelectedProvider.DisplayName}" />
                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="#9ca3af"
                                Text="{Binding AuthStatusText, StringFormat='({0})'}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Sub-Navigation Pills -->
                <Border
                    Padding="4"
                    Background="#0AFFFFFF"
                    BorderBrush="#10FFFFFF"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton
                            Style="{StaticResource TabRadioStyle}"
                            Content="Provider"
                            IsChecked="{Binding IsProviderTab}"
                            Click="Tab_Click"
                            Tag="0" />
                        <RadioButton
                            Style="{StaticResource TabRadioStyle}"
                            Content="Synced Apps"
                            IsChecked="{Binding IsAppsTab}"
                            Click="Tab_Click"
                            Tag="1" />
                        <RadioButton
                            Style="{StaticResource TabRadioStyle}"
                            Content="Clean Up 760"
                            IsChecked="{Binding IsCleanupTab}"
                            Click="Tab_Click"
                            Tag="2" />
                        <RadioButton
                            Style="{StaticResource TabRadioStyle}"
                            Content="Migration"
                            IsChecked="{Binding IsMigrationTab}"
                            Click="Tab_Click"
                            Tag="3" />
                        <RadioButton
                            Style="{StaticResource TabRadioStyle}"
                            Content="Manifest Pinning"
                            IsChecked="{Binding IsManifestTab}"
                            Click="Tab_Click"
                            Tag="4" />
                    </StackPanel>
                </Border>

                <!-- ════════════════ TAB 0: PROVIDER CONFIGURATION ════════════════ -->
                <StackPanel Visibility="{Binding IsProviderTab, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="CLOUD PROVIDER" />
                    <Border Style="{StaticResource SettingsCard}" Padding="16">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="Storage Backend" />
                                    <TextBlock FontSize="12" Foreground="#9ca3af" Text="Select where redirected Steam Cloud save files should be stored." />
                                </StackPanel>
                                <ComboBox
                                    Grid.Column="1"
                                    Width="260"
                                    ItemsSource="{Binding Providers}"
                                    SelectedItem="{Binding SelectedProvider}"
                                    DisplayMemberPath="DisplayName" />
                            </Grid>

                            <!-- Folder Provider -->
                            <StackPanel Visibility="{Binding IsFolderProvider, Converter={StaticResource BoolToVis}}">
                                <TextBlock Margin="0,8,0,4" FontSize="13" FontWeight="SemiBold" Text="Local / Network Folder Path" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Text="{Binding SyncPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button
                                        Grid.Column="1"
                                        Margin="8,0,0,0"
                                        Content="Browse"
                                        Command="{Binding BrowseSyncPathCommand}" />
                                </Grid>
                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="#9ca3af" Text="All save files will be saved in subfolders under this path: {path}/{account_id}/{app_id}/" />
                            </StackPanel>

                            <!-- Workshop Provider -->
                            <StackPanel Visibility="{Binding IsWorkshopProvider, Converter={StaticResource BoolToVis}}">
                                <TextBlock Margin="0,8,0,4" FontSize="13" FontWeight="SemiBold" Text="Workshop AppID" />
                                <ui:TextBox Text="{Binding WorkshopAppId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                
                                <TextBlock Margin="0,4,0,4" FontSize="13" FontWeight="SemiBold" Text="Visibility" />
                                <ComboBox SelectedIndex="{Binding WorkshopVisibilityIndex}" Margin="0,0,0,8">
                                    <ComboBoxItem Content="Public" />
                                    <ComboBoxItem Content="Friends Only" />
                                    <ComboBoxItem Content="Private / Unlisted" />
                                </ComboBox>

                                <TextBlock Margin="0,4,0,4" FontSize="13" FontWeight="SemiBold" Text="Local Sync Mirror Folder" />
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:TextBox Text="{Binding SyncPath, UpdateSourceTrigger=PropertyChanged}" />
                                    <ui:Button Grid.Column="1" Margin="8,0,0,0" Content="Browse" Command="{Binding BrowseSyncPathCommand}" />
                                </Grid>
                                <TextBlock FontSize="11" Foreground="#9ca3af" Text="Saves are uploaded to a private/unlisted item on the host AppID workshop using workshop_sync_tool." />
                            </StackPanel>

                            <!-- OAuth Providers (Google Drive & OneDrive) -->
                            <StackPanel Visibility="{Binding IsOAuthProvider, Converter={StaticResource BoolToVis}}">
                                <TextBlock Margin="0,8,0,4" FontSize="13" FontWeight="SemiBold" Text="Token File Path" />
                                <ui:TextBox Text="{Binding TokenPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,8">
                                    <ui:Button
                                        Appearance="Primary"
                                        Command="{Binding SignInOAuthCommand}"
                                        Content="Sign In with Browser"
                                        IsEnabled="{Binding IsAuthenticating, Converter={StaticResource InverseBoolToVis}}" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Command="{Binding CancelOAuthCommand}"
                                        Content="Cancel"
                                        Visibility="{Binding IsAuthenticating, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <TextBlock
                                    Visibility="{Binding AuthLog, Converter={StaticResource NullToCollapsed}}"
                                    FontFamily="Consolas"
                                    FontSize="11"
                                    Foreground="#a1a1aa"
                                    Text="{Binding AuthLog}" />
                            </StackPanel>

                            <!-- Cloudflare R2 Provider -->
                            <StackPanel Visibility="{Binding IsR2Provider, Converter={StaticResource BoolToVis}}">
                                <TextBlock Margin="0,8,0,4" FontSize="13" FontWeight="SemiBold" Text="R2 Account ID" />
                                <ui:TextBox Text="{Binding R2AccountId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Margin="0,4,0,4" FontSize="13" FontWeight="SemiBold" Text="Access Key ID" />
                                <ui:TextBox Text="{Binding R2AccessKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Margin="0,4,0,4" FontSize="13" FontWeight="SemiBold" Text="Secret Access Key" />
                                <ui:PasswordBox Password="{Binding R2SecretKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Margin="0,4,0,4" FontSize="13" FontWeight="SemiBold" Text="Bucket Name" />
                                <ui:TextBox Text="{Binding R2Bucket, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Margin="0,4,0,4" FontSize="13" FontWeight="SemiBold" Text="Key Prefix (Optional)" />
                                <ui:TextBox Text="{Binding R2KeyPrefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                            </StackPanel>

                            <!-- S3 Provider -->
                            <StackPanel Visibility="{Binding IsS3Provider, Converter={StaticResource BoolToVis}}">
                                <TextBlock Margin="0,8,0,4" FontSize="13" FontWeight="SemiBold" Text="Endpoint" />
                                <ui:TextBox Text="{Binding S3Endpoint, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Margin="0,4,0,4" FontSize="13" FontWeight="SemiBold" Text="Access Key ID" />
                                <ui:TextBox Text="{Binding S3AccessKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Margin="0,4,0,4" FontSize="13" FontWeight="SemiBold" Text="Secret Access Key" />
                                <ui:PasswordBox Password="{Binding S3SecretKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Margin="0,4,0,4" FontSize="13" FontWeight="SemiBold" Text="Bucket Name" />
                                <ui:TextBox Text="{Binding S3Bucket, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <TextBlock Margin="0,4,0,4" FontSize="13" FontWeight="SemiBold" Text="Region" />
                                <ui:TextBox Text="{Binding S3Region, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8" />
                                <CheckBox Content="Sign Payload" IsChecked="{Binding S3SignPayload}" Margin="0,4,0,4" />
                                <CheckBox Content="Insecure HTTP" IsChecked="{Binding S3InsecureHttp}" Margin="0,4,0,4" />
                                <CheckBox Content="Insecure TLS" IsChecked="{Binding S3InsecureTls}" Margin="0,4,0,4" />
                            </StackPanel>

                            <!-- Save / Check Buttons -->
                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <ui:Button
                                    Appearance="Primary"
                                    Command="{Binding SaveProviderSettingsCommand}"
                                    Content="Save Provider Settings" />
                                <ui:Button
                                    Margin="8,0,0,0"
                                    Command="{Binding CheckAuthCommand}"
                                    Content="Test Connection / Auth"
                                    IsEnabled="{Binding IsCheckingAuth, Converter={StaticResource InverseBoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Advanced Upload Throttling -->
                    <TextBlock Style="{StaticResource SectionHeader}" Text="BUFFERING &amp; PERFORMANCE" />
                    <Border Style="{StaticResource SettingsCard}" Padding="16">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="14" FontWeight="SemiBold" Text="In-Flight Upload Memory Limit" />
                                    <TextBlock FontSize="12" Foreground="#9ca3af" Text="RAM budget allocated for in-flight cloud upload buffers." />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource AccentFillColorDefaultBrush}"
                                    Text="{Binding UploadInflightMb, StringFormat='{}{0} MB'}" />
                            </Grid>
                            <Slider
                                Margin="0,12,0,0"
                                Minimum="4"
                                Maximum="128"
                                TickFrequency="4"
                                IsSnapToTickEnabled="True"
                                Value="{Binding UploadInflightMb}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ════════════════ TAB 1: SYNCED APPS ════════════════ -->
                <StackPanel Visibility="{Binding IsAppsTab, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Account Selector -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" FontWeight="SemiBold" Text="Steam Account:" />
                            <ComboBox
                                Width="140"
                                ItemsSource="{Binding SteamAccounts}"
                                SelectedItem="{Binding SelectedAccountId}" />
                        </StackPanel>

                        <!-- Search -->
                        <ui:TextBox
                            Grid.Column="1"
                            Margin="12,0,12,0"
                            PlaceholderText="Search games by name or AppID..."
                            Text="{Binding AppSearchQuery, UpdateSourceTrigger=PropertyChanged}" />

                        <!-- Refresh -->
                        <ui:Button
                            Grid.Column="2"
                            Command="{Binding RefreshAppsCommand}"
                            Content="Refresh"
                            Icon="{ui:SymbolIcon ArrowSync24}"
                            IsEnabled="{Binding IsLoadingApps, Converter={StaticResource InverseBoolToVis}}" />
                    </Grid>

                    <TextBlock Margin="0,0,0,8" FontSize="12" Foreground="#9ca3af" Text="{Binding AppsSummaryText}" />

                    <!-- Games List -->
                    <ItemsControl ItemsSource="{Binding DisplayedApps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:CloudSyncAppItemViewModel}">
                                <Border
                                    Margin="0,0,0,8"
                                    Padding="14"
                                    Background="#08FFFFFF"
                                    BorderBrush="#12FFFFFF"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontSize="15" FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="#71717a" Text="{Binding AppId, StringFormat='(AppID: {0})'}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock FontSize="12" Foreground="#9ca3af" Text="{Binding FileCount, StringFormat='{}{0} files'}" />
                                                <TextBlock FontSize="12" Foreground="#71717a" Text=" · " />
                                                <TextBlock FontSize="12" Foreground="#9ca3af" Text="{Binding FormattedSize}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    FontSize="11"
                                                    Foreground="#10b981"
                                                    Text="✓ Local"
                                                    Visibility="{Binding InLocalStorage, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock
                                                    Margin="6,0,0,0"
                                                    FontSize="11"
                                                    Foreground="#38bdf8"
                                                    Text="☁ Cloud"
                                                    Visibility="{Binding InRemoteStorage, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:Button
                                                Command="{Binding DataContext.RestoreAppCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="Restore Saves"
                                                Icon="{ui:SymbolIcon ArrowDownload24}"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}" />
                                            <ui:Button
                                                Margin="8,0,0,0"
                                                Command="{Binding DataContext.DeleteAppCloudDataCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Content="Delete Cloud"
                                                Appearance="Danger"
                                                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ════════════════ TAB 2: CLEAN UP 760 ════════════════ -->
                <StackPanel Visibility="{Binding IsCleanupTab, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="APPID 760 (STEAMTOOLS CONTAMINATION CLEANUP)" />
                    <Border Style="{StaticResource SettingsCard}" Padding="16">
                        <StackPanel>
                            <TextBlock
                                FontSize="13"
                                Foreground="#9ca3af"
                                Text="SteamTools redirected non-owned cloud saves into AppID 760 (Steam Screenshots). This scans your Steam userdata for leftover 760 save files and allows you to clean them up."
                                TextWrapping="Wrap" />

                            <Grid Margin="0,14,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="#e5e7eb" Text="{Binding Summary760Text}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <ui:Button
                                        Command="{Binding Scan760Command}"
                                        Content="Scan 760 Files"
                                        IsEnabled="{Binding IsScanning760, Converter={StaticResource InverseBoolToVis}}" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Command="{Binding DeleteSelected760Command}"
                                        Content="Delete Selected"
                                        Appearance="Danger" />
                                    <ui:Button
                                        Margin="8,0,0,0"
                                        Command="{Binding ClearAll760Command}"
                                        Content="Clear All 760"
                                        Appearance="Danger" />
                                </StackPanel>
                            </Grid>

                            <!-- 760 Files List -->
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Files760}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:Steam760FileItemViewModel}">
                                            <Border
                                                Margin="0,0,0,4"
                                                Padding="8,6"
                                                Background="#04FFFFFF"
                                                CornerRadius="4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Foreground="#71717a" Text="{Binding FormattedSize}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ════════════════ TAB 3: MIGRATION ════════════════ -->
                <StackPanel Visibility="{Binding IsMigrationTab, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="MIGRATE CLOUD SAVES" />
                    <Border Style="{StaticResource SettingsCard}" Padding="16">
                        <StackPanel>
                            <TextBlock
                                FontSize="13"
                                Foreground="#9ca3af"
                                Text="Copy all cloud save files from one cloud provider to another."
                                TextWrapping="Wrap" />

                            <Grid Margin="0,16,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="Source Provider" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding MigrationSource}" DisplayMemberPath="DisplayName" />
                                </StackPanel>
                                <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" VerticalAlignment="Center" Margin="16,24,16,0" Foreground="#71717a" />
                                <StackPanel Grid.Column="2">
                                    <TextBlock FontSize="13" FontWeight="SemiBold" Text="Destination Provider" Margin="0,0,0,6" />
                                    <ComboBox ItemsSource="{Binding Providers}" SelectedItem="{Binding MigrationDest}" DisplayMemberPath="DisplayName" />
                                </StackPanel>
                            </Grid>

                            <ui:Button
                                Appearance="Primary"
                                Command="{Binding StartMigrationCommand}"
                                Content="Start Migration"
                                IsEnabled="{Binding IsMigrating, Converter={StaticResource InverseBoolToVis}}" />

                            <!-- Log Viewer -->
                            <TextBlock Margin="0,16,0,4" FontSize="12" FontWeight="SemiBold" Text="Migration Log Output" />
                            <Border Background="#0D000000" BorderBrush="#15FFFFFF" BorderThickness="1" CornerRadius="6" Padding="10">
                                <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                    <TextBlock FontFamily="Consolas" FontSize="11" Foreground="#d4d4d8" Text="{Binding MigrationLog}" TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ════════════════ TAB 4: MANIFEST PINNING ════════════════ -->
                <StackPanel Visibility="{Binding IsManifestTab, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource SectionHeader}" Text="STEAM MANIFEST PINNING" />
                    <Border Style="{StaticResource SettingsCard}" Padding="16">
                        <StackPanel>
                            <TextBlock
                                FontSize="13"
                                Foreground="#9ca3af"
                                Text="Prevent Steam client from automatically updating pinned game manifests."
                                TextWrapping="Wrap" />

                            <CheckBox
                                Margin="0,14,0,6"
                                Content="Enable Manifest Pinning"
                                IsChecked="{Binding ManifestPinningEnabled}" />
                            <CheckBox
                                Margin="0,0,0,14"
                                Content="Auto-Comment unpinned game depots"
                                IsChecked="{Binding AutoCommentEnabled}" />

                            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Pinned App IDs (one per line):" Margin="0,0,0,4" />
                            <ui:TextBox
                                Height="160"
                                AcceptsReturn="True"
                                VerticalScrollBarVisibility="Auto"
                                Text="{Binding PinnedAppIdsText, UpdateSourceTrigger=PropertyChanged}" />

                            <ui:Button
                                Margin="0,14,0,0"
                                Appearance="Primary"
                                Command="{Binding SaveManifestPinningCommand}"
                                Content="Save Manifest Pinning" />
                        </StackPanel>
                    </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
